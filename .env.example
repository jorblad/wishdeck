# Copy to .env and adjust. Variables here (Layer 2) OVERRIDE the UI-editable
# settings stored in the system_settings table.

# ---- Infrastructure (never UI-editable) ----
SECRET_KEY=generate-a-long-random-string-here
ENVIRONMENT=production
BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
HTTP_PORT=8080

# ---- Feature flags / product behaviour ----
ENABLE_REGISTRATION=true
DEFAULT_LOCALE=en
DEFAULT_VISIBILITY=private
ALLOW_PUBLIC_CLAIMS=true

# ---- OIDC / SAML (mixed-mode SSO) ----
# Set OIDC_ENABLED=true and fill the block below to show SSO on the login page.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO
OIDC_SCOPES=openid email profile
# OIDC_REDIRECT_URI defaults to {BASE_URL}/api/v1/auth/oidc/callback
